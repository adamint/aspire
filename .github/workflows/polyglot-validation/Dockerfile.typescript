# Polyglot SDK Validation - TypeScript
# This Dockerfile sets up an environment for validating the TypeScript AppHost SDK
#
# Usage:
#   docker build -f Dockerfile.typescript -t polyglot-typescript .
#   docker run --rm \
#     -v "$(pwd):/workspace" \
#     -v /var/run/docker.sock:/var/run/docker.sock \
#     polyglot-typescript
#
# Note: Expects self-extracting binary and NuGet artifacts to be pre-downloaded to /workspace/artifacts/
#
ARG NODE_VERSION=24
FROM mcr.microsoft.com/devcontainers/typescript-node:${NODE_VERSION}
ARG NODE_VERSION
ARG TYPESCRIPT_VERSION=7.0.2
ARG NPM_REGISTRY=https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-public-npm/npm/registry/

# Ensure Yarn APT repository signing key is available (base image includes Yarn repo)
RUN curl -sS https://dl.yarnpkg.com/debian/pubkey.gpg | gpg --dearmor | sudo tee /etc/apt/keyrings/yarn-archive-keyring.gpg > /dev/null

# Install system dependencies and verify the MCR base image provides the requested Node.js runtime.
RUN case "$NODE_VERSION" in 22|24) ;; *) echo "Unsupported NODE_VERSION: $NODE_VERSION" >&2; exit 1 ;; esac && \
    apt-get update && apt-get install -y \
    wget \
    docker.io \
    jq \
    && node --version | grep -E "^v${NODE_VERSION}\\." \
    && rm -rf /var/lib/apt/lists/*

# TypeScript validation fixtures intentionally cover npm, pnpm, Yarn 4+, and Bun
# package-manager markers, so make all selected tools available in the image.
# Install each tool directly because Corepack's package-manager downloads bypass
# NPM_REGISTRY and would acquire pnpm and Yarn outside dotnet-public-npm.
#
# TypeScript 7 (the native Go compiler) ships as the plain `typescript` package with a `tsc` binary
# since 7.0 GA, replacing the pre-GA `@typescript/native-preview` package and its `tsgo` binary.
# See https://devblogs.microsoft.com/typescript/announcing-typescript-7-0/.
#
# `--registry` sets npm's *default* registry only. A `@scope:registry` key is a separate setting that
# always wins for that scope, and neither `--registry` nor npm_config_registry overrides it - the
# same npm behaviour npm-registry-env.sh isolates against at job time, measured in
# NpmLockfileRegistryTests.RegistryEnvScript_IsolatesNpmFromAmbientScopedRegistries. This command
# acquires scoped packages (@yarnpkg/cli-dist directly, and typescript's @typescript/* platform
# packages transitively), so a scoped key baked into the base image would redirect exactly those.
# The runtime helper cannot cover this: it is sourced by /scripts, which do not run until the
# entrypoint, long after this layer has already downloaded the toolchain.
#
# npm resolves config as cli > env > project .npmrc > user .npmrc > global .npmrc > builtin. Owning
# the user config and the working directory therefore outranks every source an ambient scoped key
# could come from, so each scope npm reports is re-pinned to the approved feed in the user config
# rather than compared against it - there is no value to normalize and no way for the check to pass
# while the install still resolves elsewhere.
#
# `npm config list` prints one setting per line, quoted, with `;`-prefixed comments naming the file
# each block came from:
#   @types:registry = "https://scoped.example.invalid/"
#
# The global config is left alone on purpose: it is where the base image records the `prefix` that
# --global installs use, and blanking it would relocate the binaries this layer then verifies.
#
# The NPM_REGISTRY build arg is checked against the approved feed first, for the reason
# npm-registry-env.sh rejects the same override at job time: if the arg were treated as the
# expected value, `--build-arg NPM_REGISTRY=https://registry.npmjs.org` would make every step below
# agree with itself while the toolchain came from an unapproved host.
RUN APPROVED_NPM_REGISTRY=https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-public-npm/npm/registry/ && \
    if [ "${NPM_REGISTRY%/}" != "${APPROVED_NPM_REGISTRY%/}" ]; then \
        echo "NPM_REGISTRY build arg '${NPM_REGISTRY}' is not the approved feed '${APPROVED_NPM_REGISTRY}'." >&2; \
        exit 1; \
    fi && \
    mkdir -p /usr/local/etc/polyglot-npm && \
    printf 'registry=%s\n' "${NPM_REGISTRY}" > /usr/local/etc/polyglot-npm/npmrc && \
    export NPM_CONFIG_USERCONFIG=/usr/local/etc/polyglot-npm/npmrc && \
    npm config list | sed -n 's/^\(@[^:]*\):registry = .*/\1/p' | sort -u | \
    while read -r scope; do \
        echo "Re-pinning ambient npm scope ${scope} to ${NPM_REGISTRY}"; \
        printf '%s:registry=%s\n' "${scope}" "${NPM_REGISTRY}" >> /usr/local/etc/polyglot-npm/npmrc; \
    done && \
    cd /usr/local/etc/polyglot-npm && \
    npm install --global --force --registry "${NPM_REGISTRY}" \
    pnpm@10.0.0 \
    @yarnpkg/cli-dist@4.14.1 \
    bun@1.2.0 \
    "typescript@${TYPESCRIPT_VERSION}" && \
    test "$(pnpm --version)" = "10.0.0" && \
    test "$(yarn --version)" = "4.14.1" && \
    test "$(bun --version)" = "1.2.0" && \
    test "$(tsc --version)" = "Version ${TYPESCRIPT_VERSION}"

# Pre-configure Aspire CLI path
ENV PATH="/root/.aspire/bin:${PATH}"
ENV ASPIRE_CLI_TELEMETRY_OPTOUT=1

WORKDIR /workspace

# Copy the whole script directory rather than naming files individually. Enumerating them meant a
# script could reference a sibling that was never added to the image — a helper extracted out of one
# of these scripts is invisible until the job runs and the `source` fails.
COPY *.sh /scripts/
RUN chmod +x /scripts/*.sh

# Entrypoint: Set up Aspire CLI and run validation
# Bundle extraction happens lazily on first command that needs the layout
ENTRYPOINT ["/bin/bash", "-c", "\
    set -e && \
    /scripts/setup-local-cli.sh && \
    /scripts/test-typescript.sh && \
    /scripts/test-typescript-playground.sh \
"]
